# PostgreSQL connection (docker compose provides this by default)
DATABASE_URL=postgresql://nilai:nilai@localhost:5432/nilai

# Cookie signing secret — any long random string
SESSION_SECRET=change-me-in-production

# Vector column size. Must match the embedding model's output dimension
# (1536 = text-embedding-3-small, 768 = text-embedding-004 / nomic-embed-text,
#  1024 = bge-m3 / mxbai-embed-large, 3072 = gemini-embedding-001).
EMBEDDING_DIM=1536

# Top-k chunks retrieved into the grading prompt
EMBEDDING_TOP_K=6

# Chat model for AI grading (OpenAI-compatible /chat/completions).
# Seeded into model_settings on first boot; /admin/settings edits win until
# the database volume is reset.
LLM_PROVIDER_LABEL=
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=

# Embeddings for PDF/DOCX RAG grading (OpenAI-compatible /embeddings).
# e.g. EMB_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#      EMB_MODEL_NAME=gemini-embedding-001  (with EMBEDDING_DIM=3072)
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL_NAME=
