flowchart TD
  S["Admin: halaman Pengguna"] --> CHOICE{"Onboard pengguna baru"}
  CHOICE --> MANUAL["Manual: form Tambah pengguna<br/>nama, email, peran, status"]
  CHOICE --> EXCEL["Excel: unggah .xlsx<br/>maks 500 baris / 2 MB<br/>(template tersedia untuk diunduh)"]
  EXCEL --> PARSE["Baca workbook<br/>header: Nama, Email, Peran, Status"]
  PARSE --> VALID["Validasi + normalisasi<br/>alias peran: dosen/mahasiswa<br/>alias status: aktif/nonaktif<br/>cek format email"]
  VALID --> PREVIEW{"Preview (server)"}
  PREVIEW --> READY["Siap diimpor"]
  PREVIEW --> SKIP1["Email sudah terdaftar<br/>+ duplikat dalam file"]
  PREVIEW --> SKIP2["Baris invalid<br/>(nama/email error)"]
  READY --> CONFIRM["Konfirmasi impor<br/>INSERT ... ON CONFLICT DO NOTHING"]
  MANUAL --> SAVE["Simpan pengguna<br/>hash password default<br/>password123"]
  SKIP1 -.->|"dilewati, tidak pernah ditimpa"| DONE
  SKIP2 -.-> DONE
  CONFIRM --> DONE["Tabel Pengguna diperbarui"]
  SAVE --> DONE
  DONE --> PLACE["Placement:<br/>enroll mahasiswa ke kelas"]
